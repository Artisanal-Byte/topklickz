---
// src/components/CertificationsCredentials.astro

const certifications = [
	{
		image: "/images/certifications/cbap.png",
		title: "CBAP — CERTIFIED BUSINESS ANALYSIS PROFESSIONAL",
	},
	{
		image: "/images/certifications/aws-solutions-architect.png",
		title: "AWS CERTIFIED — SOLUTIONS ARCHITECT",
	},
	{
		image: "/images/certifications/six-sigma-black-belt.png",
		title: "6Σ — SIX SIGMA MASTER BLACK BELT",
	},
	{
		image: "/images/certifications/csm.png",
		title: "CSM CERTIFIED — CERTIFIED SCRUM MASTER",
	},
	{
		image: "/images/certifications/pspo.png",
		title: "PSPO — SCRUM PRODUCT OWNER",
	},
];
---

<section class="w-full bg-white">
	<div
		class="
			mx-auto
			max-w-6xl
			px-5
			py-12
			lg:px-5
			lg:py-14
		"
	>
		<!-- =========================
			HEADING
		========================= -->
		<div>
			<h2
				class="
					font-clash
					text-[27px]
					font-medium
					uppercase
					leading-none
					tracking-[-1px]
					text-black
					sm:text-[30px]
					lg:text-[31px]
				"
			>
				CERTIFICATIONS & CREDENTIALS
			</h2>

			<!-- Gradient underline -->
			<div
				class="
					mt-[7px]
					h-[3px]
					w-[60px]
					bg-gradient-to-r
					from-[#FFAF42]
					via-[#FF684B]
					to-[#F0195A]
				"
			>
			</div>
		</div>

		<!-- =========================
			CERTIFICATION CARDS
		========================= -->
		<div
			class="
				mt-5
				grid
				grid-cols-2
				gap-5
				sm:grid-cols-3
				lg:grid-cols-5
				lg:gap-[24px]
			"
		>
			{
				certifications.map((item) => (
					<div
						class="
							group
							relative
							rounded-[13px]
							bg-gradient-to-br
							from-[#FFBD5A]
							via-[#FFD6C3]
							to-[#FF4D68]
							p-[1px]
							shadow-[0_4px_5px_rgba(0,0,0,0.16)]
							transition-all
							duration-300
							hover:-translate-y-1
							hover:shadow-[0_8px_18px_rgba(0,0,0,0.14)]
						"
					>
						<div
							class="
								flex
								min-h-[150px]
								h-full
								flex-col
								items-center
								justify-between
								rounded-[12px]
								bg-white
								px-3
								py-3
								sm:min-h-[165px]
								lg:min-h-[150px]
							"
						>
							<!-- Logo -->
							<div
								class="
									flex
									h-[78px]
									w-full
									items-center
									justify-center
								"
							>
								<img
									src={item.image}
									alt={item.title}
									loading="lazy"
									class="
										max-h-[70px]
										max-w-[95px]
										object-contain
										transition-transform
										duration-300
										group-hover:scale-[1.04]
									"
								/>
							</div>

							<!-- Title -->
							<h3
								class="
									mt-3
									max-w-[150px]
									text-center
									font-satoshi
									text-[9px]
									font-medium
									uppercase
									leading-[1.25]
									tracking-[-0.1px]
									text-[#242424]
								"
							>
								{item.title}
							</h3>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>