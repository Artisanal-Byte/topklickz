---
const stats = [
	{
		value: "8+",
		label: "YEARS OF EXPERIENCE",
	},
	{
		value: "150+",
		label: "PROJECTS DELIVERED",
	},
	{
		value: "30+",
		label: "BRANDS BUILT",
	},
	{
		value: "20+",
		label: "INDUSTRIES SERVED",
	},
	{
		value: "98%",
		label: "CLIENT RETENTION",
	},
];
---

<section class="w-full bg-white">
	<div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
		<!-- Top line -->
		<div class="border-t border-[#0000001A]">
			<div
				class="
					grid
					grid-cols-2
					lg:grid-cols-5
				"
			>
				{
					stats.map((stat, index) => (
						<div
							class:list={[
								`
									flex
									min-h-[100px]
									flex-col
									justify-center
									px-4
									py-6
									sm:min-h-[115px]
									lg:px-4
								`,
								index !== 0 &&
									"border-l border-[#0000001A]",
							]}
						>
							<h3
								class="
									bg-gradient-to-r
									from-[#ff6546]
									via-[#f22054]
									to-[#c822ae]
									bg-clip-text
									text-[27px]
									font-bold
									leading-none
									tracking-[-0.8px]
									text-transparent
                                    lg:text-[40px]
								"
							>
								{stat.value}
							</h3>

							<p
								class="
									mt-4
									text-[8px]
									font-normal
									uppercase
									leading-[1.3]
									tracking-[0.2px]
									text-[#888888]
                                    lg:text-[12px]
								"
							>
								{stat.label}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>