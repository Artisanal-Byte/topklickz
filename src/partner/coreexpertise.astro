---
// src/components/CoreExpertise.astro

const expertise = [
	{
		title: "BUSINESS ANALYSIS",
		description:
			"BRD, FRD, User Stories, UAT, Stakeholder Management",
	},
	{
		title: "DIGITAL TRANSFORMATION",
		description:
			"BRD, FRD, User Stories, UAT, Stakeholder Management",
	},
	{
		title: "AI & PROMPT ENGINEERING",
		description:
			"BRD, FRD, User Stories, UAT, Stakeholder Management",
	},
	{
		title: "CLOUD & AWS",
		description:
			"BRD, FRD, User Stories, UAT, Stakeholder Management",
	},
	{
		title: "GIS & SPATIAL INTELLIGENCE",
		description:
			"BRD, FRD, User Stories, UAT, Stakeholder Management",
	},
	{
		title: "DATA & ANALYTICS",
		description:
			"BRD, FRD, User Stories, UAT, Stakeholder Management",
	},
];

const industries = [
	{
		title: "FEDERAL & PUBLIC SERVICES",
		type: "government",
		color: "#FF974B",
	},
	{
		title: "IMMIGRATION & CITIZENSHIP SERVICES",
		type: "document",
		color: "#F3484B",
	},
	{
		title: "TRANSPORTATION & LOGISTICS",
		type: "truck",
		color: "#C027A5",
	},
	{
		title: "EDUCATION & PUBLIC INSTITUTIONS",
		type: "education",
		color: "#6340D8",
	},
	{
		title: "PROFESSIONAL SERVICES",
		type: "users",
		color: "#F33672",
	},
];
---

<section class="w-full bg-white">
	<div
		class="
			mx-auto
			max-w-7xl
			px-5
			py-14
			lg:px-10
			lg:py-20
		"
	>
		<div
			class="
				grid
				grid-cols-1
				gap-16
				lg:grid-cols-[minmax(0,2.35fr)_minmax(340px,0.85fr)]
				lg:gap-[70px]
			"
		>
			<!-- ===================================================
				LEFT SIDE
			=================================================== -->
			<div class="min-w-0">
				<!-- Heading -->
				<div>
					<h2
						class="
							font-clash
							text-[42px]
							font-bold
							uppercase
							leading-[0.95]
							tracking-[-2px]
							text-black
							lg:text-[46px]
						"
					>
						CORE EXPERTISE
					</h2>

					<div
						class="
							mt-5
							h-[6px]
							w-[210px]
							bg-gradient-to-r
							from-[#FFB343]
							via-[#FF7346]
							to-[#EF1757]
						"
					>
					</div>
				</div>
				<div
					class="
						mt-8
						grid
						grid-cols-1
						lg:grid-cols-3
					"
				>
					{
						expertise.map((item, index) => (
							<div
								class="
									relative
									flex
									flex-col
									justify-center
									px-5
									py-8
								"
							>
								{
									index !== expertise.length - 1 && (
										<span
											class="
												absolute
												bottom-0
												left-5
												right-5
												h-px
												bg-[#E5E5E5]
												sm:hidden
											"
										/>
									)
								}
								{
									index % 2 !== 0 && (
										<span
											class="
												absolute
												left-0
												top-1/2
												hidden
												h-[106px]
												w-px
												-translate-y-1/2
												bg-[#D7D7D7]
												sm:block
												xl:hidden
											"
										/>
									)
								}

								{
									index % 3 !== 0 && (
										<span
											class="
												absolute
												left-0
												top-1/2
												hidden
												h-[106px]
												w-px
												-translate-y-1/2
												bg-[#D3D3D3]
												xl:block
											"
										/>
									)
								}

								<!-- Content -->
								<div>
									<h3
										class="
											font-clash
											text-[20px]
											font-medium
											uppercase
											leading-[1.12]
											tracking-[-0.8px]
											text-[#050505]
											lg:text-[20px]
										"
									>
										{item.title}
									</h3>

									<p
										class="
											mt-[10px]
											max-w-[245px]
											font-satoshi
											text-[12px]
											font-normal
											leading-[1.45]
											tracking-[-0.2px]
											text-[#777777]
										"
									>
										{item.description}
									</p>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class="min-w-0 lg:pt-1">
				<!-- Heading -->
				<h2
					class="
						font-clash
						text-[38px]
						font-bold
						uppercase
						leading-[0.95]
						tracking-[-1.5px]
						text-black
						lg:text-[32px]
					"
				>
					INDUSTRIES
					SERVED
				</h2>

				<div
					class="
						mt-12
						flex
						lg:mt-[50px]
					"
				>
					<!-- Vertical Orange Line -->
					<div
						class="
							mr-8
							w-[5px]
							shrink-0
							self-stretch
							rounded-full
							bg-[#FFAD3D]
							sm:mr-10
							lg:mr-[42px]
						"
					>
					</div>

					<!-- Industries -->
					<div
						class="
							flex
							min-w-0
							flex-1
							flex-col
							gap-[34px]
						"
					>
						{
							industries.map((industry) => (
								<div
									class="
										grid
										grid-cols-[55px_minmax(0,1fr)]
										items-center
										gap-6
									"
								>
									<div
										class="
											flex
											h-[48px]
											w-[55px]
											shrink-0
											items-center
											justify-center
										"
										style={`color:${industry.color}`}
									>
										<!-- GOVERNMENT -->
										{
											industry.type === "government" && (
												<svg
													viewBox="0 0 52 52"
													fill="none"
													xmlns="http://www.w3.org/2000/svg"
													class="h-[46px] w-[46px]"
												>
													<path
														d="M7 16L26 7L45 16"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>

													<path
														d="M9 18H43"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M12 43H40"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M8 47H44"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M15 22V39"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M23 22V39"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M31 22V39"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M39 22V39"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>
												</svg>
											)
										}

										<!-- DOCUMENT -->
										{
											industry.type === "document" && (
												<svg
													viewBox="0 0 52 52"
													fill="none"
													xmlns="http://www.w3.org/2000/svg"
													class="h-[46px] w-[46px]"
												>
													<path
														d="M15 5H31L40 14V43C40 45.2 38.2 47 36 47H15C12.8 47 11 45.2 11 43V9C11 6.8 12.8 5 15 5Z"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linejoin="round"
													/>

													<path
														d="M31 5V15H40"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linejoin="round"
													/>

													<path
														d="M18 25H33"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M18 33H33"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>
												</svg>
											)
										}

										<!-- TRUCK -->
										{
											industry.type === "truck" && (
												<svg
													viewBox="0 0 55 52"
													fill="none"
													xmlns="http://www.w3.org/2000/svg"
													class="h-[48px] w-[48px]"
												>
													<path
														d="M5 14H31V39H5V14Z"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linejoin="round"
													/>

													<path
														d="M31 23H40L48 31V39H31V23Z"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linejoin="round"
													/>

													<circle
														cx="15"
														cy="40"
														r="5"
														fill="white"
														stroke="currentColor"
														stroke-width="3.5"
													/>

													<circle
														cx="40"
														cy="40"
														r="5"
														fill="white"
														stroke="currentColor"
														stroke-width="3.5"
													/>
												</svg>
											)
										}

										<!-- EDUCATION -->
										{
											industry.type === "education" && (
												<svg
													viewBox="0 0 55 52"
													fill="none"
													xmlns="http://www.w3.org/2000/svg"
													class="h-[48px] w-[48px]"
												>
													<path
														d="M5 18L27 8L49 18L27 28L5 18Z"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linejoin="round"
													/>

													<path
														d="M14 23V33C14 33 18 40 27 40C36 40 40 33 40 33V23"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linejoin="round"
													/>

													<path
														d="M49 18V31"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>
												</svg>
											)
										}

										<!-- USERS -->
										{
											industry.type === "users" && (
												<svg
													viewBox="0 0 55 52"
													fill="none"
													xmlns="http://www.w3.org/2000/svg"
													class="h-[48px] w-[48px]"
												>
													<circle
														cx="23"
														cy="16"
														r="8"
														stroke="currentColor"
														stroke-width="3.5"
													/>

													<path
														d="M9 43V37C9 29.3 15.3 23 23 23C30.7 23 37 29.3 37 37V43"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M37 10C41.5 10.6 45 14.4 45 19C45 23.6 41.5 27.4 37 28"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>

													<path
														d="M40 31C45 33 48 37 48 43"
														stroke="currentColor"
														stroke-width="3.5"
														stroke-linecap="round"
													/>
												</svg>
											)
										}
									</div>

									<!-- Industry Text -->
									<h3
										class="
											max-w-[235px]
											font-satoshi
											text-[16px]
											font-semibold
											uppercase
											leading-[1.55]
											tracking-[-0.3px]
											text-[#070707]
											lg:text-[17px]
										"
									>
										{industry.title}
									</h3>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>