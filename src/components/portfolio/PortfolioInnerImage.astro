<section class="w-full bg-[#f7f6f2] py-5">
	<div class="mx-auto w-full max-w-7xl px-4 lg:px-5">

		<!-- =========================
			DESKTOP / TABLET
		========================= -->
		<div class="hidden md:block">

			<!-- TOP ROW -->
			<div
				class="
					grid
					h-[280px]
					grid-cols-[46%_23%_1fr]
					gap-[7px]

					lg:h-[340px]
					xl:h-[420px]
				"
			>
				<!-- Image 1 -->
				<div
					class="
						group
						relative
						h-full
						w-full
						overflow-hidden
						rounded-[10px]
						bg-[#ecebe7]
					"
				>
					<img
						src={galleryImages[0].src}
						alt={galleryImages[0].alt}
						class="
							h-full
							w-full
							object-cover
							object-center
							transition-transform
							duration-700
							ease-out
							group-hover:scale-[1.035]
						"
					/>
				</div>

				<!-- Image 2 -->
