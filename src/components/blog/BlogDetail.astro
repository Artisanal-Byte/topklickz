---
interface Props {
  title?: string;
  heroImage?: string;
  heroImageAlt?: string;
}

const {
  title = "Blog Article",
  heroImage,
  heroImageAlt = "",
} = Astro.props;
---

<article class="w-full bg-white">
  <div class="mx-auto w-full max-w-5xl px-5 py-10 lg:px-0 lg:py-16">
    <header>
      <h1
        class="max-w-[760px] text-[28px] font-semibold leading-[1.08] tracking-[-0.5px] text-black sm:text-[42px]"
      >
        {title}
      </h1>
    </header>

    {heroImage && (
      <div class="relative mt-8 aspect-[1.75/1] w-full overflow-hidden rounded-[10px] sm:mt-10">
        <img
          src={heroImage}
          alt={heroImageAlt || title}
          class="absolute inset-0 h-full w-full object-cover object-center"
        />
      </div>
    )}

    <div class="article-content mt-10">
      <slot />
    </div>

    <footer class="mt-10 border-t border-black/15 pt-5">
      <div class="flex items-center justify-between gap-4">
        <span class="text-[14px] text-black/55">Share article</span>
        <div class="flex gap-2">
          <a
            href="https://x.com/intent/post"
            target="_blank"
            rel="noreferrer"
            aria-label="Share on X"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-black text-[11px] font-medium text-white"
          >X</a>
          <a
            href="https://www.linkedin.com/sharing/share-offsite/"
            target="_blank"
            rel="noreferrer"
            aria-label="Share on LinkedIn"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-black text-[10px] font-semibold text-white"
          >in</a>
        </div>
      </div>

      <a
        href="/blog"
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-black px-4 py-2 text-[15px] font-medium text-white transition-opacity hover:opacity-75"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-[#ff2d55] to-[#7c3aed]"></span>
        More Insights
      </a>
    </footer>
  </div>
</article>

<style>
  .article-content {
    max-width: 880px;
    margin-right: auto;
    margin-left: auto;
    color: rgb(24 24 27 / 0.78);
    font-size: 17px;
    line-height: 1.6;
  }

  .article-content :global(p) {
    margin: 0 0 0.8rem;
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    margin-top: 1.9rem;
    margin-bottom: 0.6rem;
    color: #111111;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .article-content :global(h1) {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .article-content :global(h2) {
    font-size: clamp(1.65rem, 3vw, 2.2rem);
  }

  .article-content :global(h3) {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    font-size: 1.2rem;
  }

  .article-content :global(h1:first-child),
  .article-content :global(h2:first-child),
  .article-content :global(h3:first-child) {
    margin-top: 0;
  }

  .article-content :global(strong) {
    color: #111111;
    font-weight: 700;
  }

  .article-content :global(em) {
    color: rgb(24 24 27 / 0.9);
  }

  .article-content :global(a) {
    color: #7c3aed;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 0.9rem;
    padding-left: 1.5rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(li) {
    margin: 0.25rem 0;
    padding-left: 0.25rem;
  }

  .article-content :global(blockquote) {
    margin: 1.35rem 0;
    border-left: 3px solid #7c3aed;
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: rgb(24 24 27 / 0.65);
    font-size: 1.08em;
    font-style: italic;
  }

  .article-content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.35rem 0;
    border-radius: 12px;
  }

  .article-content :global(hr) {
    margin: 1.75rem 0;
    border: 0;
    border-top: 1px solid rgb(24 24 27 / 0.14);
  }

  .article-content :global(code) {
    border-radius: 4px;
    background: rgb(24 24 27 / 0.07);
    padding: 0.15em 0.35em;
    font-size: 0.9em;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    margin: 1.5rem 0;
    border-radius: 10px;
    background: #18181b;
    padding: 1rem;
    color: white;
  }

  @media (max-width: 640px) {
    .article-content {
      font-size: 16px;
      line-height: 1.55;
    }
  }
</style>
