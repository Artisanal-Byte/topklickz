---
interface ContentSection {
	title: string;
	description: string;
}

interface Props {
	title?: string;
	description?: string;
	author?: string;
	authorImage?: string;
	date?: string;
	readTime?: string;
	tags?: string[];
	heroImage?: string;
	heroImageAlt?: string;
	heroBadge?: string;
	heroTitle?: string;
	contentImage?: string;
	contentImageAlt?: string;
	secondaryImage?: string;
	secondaryImageAlt?: string;
	intro?: string[];
	sections?: ContentSection[];
	secondarySections?: ContentSection[];
}

const {
	title = "Blog Article",
	description = "",
	author = "",
	authorImage = "",
	date = "",
	readTime = "",
	tags = [],
	heroImage,
	heroImageAlt = "",
	heroBadge = "",
	heroTitle,
	contentImage,
	contentImageAlt = "",
	secondaryImage,
	secondaryImageAlt = "",
	intro = [],
	sections = [],
	secondarySections = [],
} = Astro.props;

const displayHeroTitle = heroTitle || title;
const hasStructuredContent =
	intro.length > 0 || sections.length > 0 || secondarySections.length > 0;
---

<article class="w-full bg-white">
	<div class="mx-auto
			w-full
			max-w-5xl
			px-5
			py-10
			lg:px-0
			lg:py-16">
		<!-- =============================
		     ARTICLE HEADER
		============================= -->
		<header>
			<h1
				class="max-w-[520px]
					text-[22px]
					font-semibold
					leading-[1.12]
					tracking-[-0.5px]
					text-black
					sm:text-[28px]
					sm:leading-[1.08]"
			>
				{title}
			</h1>

			<!-- Author / Meta -->
			<div
				class="mt-4
					flex
					flex-col
					gap-4
					sm:flex-row
					sm:items-center
					sm:justify-between"
			>
				<!-- Left -->
				<div class="flex items-center gap-3">
					{author && authorImage && (
						<img
							src={authorImage}
							alt={author}
							class="h-[24px]
							w-[24px]
							shrink-0
							rounded-full
							object-cover"
						/>
					)}

					{author && <span class="text-[15px]
							font-medium
							text-black/70">
						{author}
					</span>}

					{
						tags.map((tag) => (
							<span
								class="
									rounded-full
									bg-[#f2f2f2]
									px-[9px]
									py-[4px]
									text-[17px]
									font-medium
									text-black/60
								"
							>
								{tag}
							</span>
						))
					}
				</div>

				<!-- Right -->
				<div class="flex
						items-center
						gap-2
						text-[15px]
						text-black/45">
					{date && <span>{date}</span>}
					<span>•</span>
					{readTime && <span>{readTime}</span>}
				</div>
			</div>
		</header>

		{description && (
			<p class="mt-6 max-w-[760px] text-[17px] leading-[1.45] text-black/70">
				{description}
			</p>
		)}

		<!-- =============================
		     HERO IMAGE
		============================= -->
		{heroImage && <div
			class="relative
				mt-8
				aspect-[1.75/1]
				w-full
				overflow-hidden
				rounded-[10px]
				sm:mt-10"
		>
			<img
				src={heroImage}
				alt={heroImageAlt || displayHeroTitle}
				class="absolute
					inset-0
					h-full
					w-full
					object-cover
					object-center"
			/>

			<!-- subtle overlay -->
			<div
				class="absolute
					inset-0
					bg-[linear-gradient(90deg,rgba(0,0,0,0.27)_0%,rgba(0,0,0,0.08)_55%,rgba(0,0,0,0)_100%)]"
			>
			</div>

			<!-- Featured -->
			{heroBadge && <span
				class="absolute
					left-4
					top-4
					z-10
					rounded-[3px]
					bg-black
					px-[7px]
					py-[4px]
					text-[13px]
					font-semibold
					uppercase
					leading-none
					text-white"
			>
				{heroBadge}
			</span>}

			<!-- Hero title -->
			<div
				class="absolute
		inset-0
		z-10
		flex
		items-center mx-20"
			>
				<div class="max-w-[420px]">
					<h2
						class="text-[52px]
				font-bold
				leading-[0.95]
				tracking-[-1.5px]
				text-white"
					>
						{displayHeroTitle}
					</h2>
				</div>
			</div>
		</div>}

		<!-- =============================
		     INTRO
		============================= -->
		{intro.length > 0 && <div
			class="mt-9
				space-y-[2px]
				text-[17px]
				font-normal
				leading-[1.35]
				text-black/75
				sm:leading-[1.45]"
		>
			{intro.map((paragraph) => <p>{paragraph}</p>)}
		</div>}

		<!-- =============================
		     ARTICLE SECTIONS
		============================= -->
		{hasStructuredContent ? <div class="mt-8">
			{
				sections.map((section, index) => (
					<>
						<section
							class="
								border-t
								border-black/20
								py-6

								sm:py-7
							"
						>
							<h3
								class="
									text-[15px]
									font-semibold
									leading-[1.25]
									text-black

									sm:text-[16px]
								"
							>
								{section.title}
							</h3>

							<p
								class="
									mt-2
									text-[17px]
									leading-[1.35]
									text-black/75
								"
							>
								{section.description}
							</p>
						</section>

						{index === 1 && contentImage && (
							<figure class="my-2 overflow-hidden rounded-[10px] sm:my-4">
								<img
									src={contentImage}
									alt={contentImageAlt}
									loading="lazy"
									class="h-auto w-full object-cover"
								/>
							</figure>
						)}
					</>
				))
			}

			<div class="mt-8">
				{
					secondarySections.map((section, index) => (
						<>
							<section
								class="
									border-t
									border-black/20
									py-6

									sm:py-7
								"
							>
								<h3
									class="
										text-[15px]
										font-semibold
										leading-[1.25]
										text-black

										sm:text-[16px]
									"
								>
									{section.title}
								</h3>

								<p
									class="
										mt-2
										text-[17px]
										leading-[1.35]
										text-black/75
									"
								>
									{section.description}
								</p>
							</section>

							{index === 1 && secondaryImage && (
								<figure class="my-2 overflow-hidden rounded-[10px] sm:my-4">
									<img
										src={secondaryImage}
										alt={secondaryImageAlt}
										loading="lazy"
										class="h-auto w-full object-cover"
									/>
								</figure>
							)}
						</>
					))
				}
			</div>

			<!-- Last line -->
			<div class="h-px w-full bg-black/20"></div>
		</div> : (
			<div class="mt-9 text-[17px] leading-[1.5] text-black/75">
				<slot />
			</div>
		)}

		<!-- =============================
		     ARTICLE FOOTER
		============================= -->
		<footer class="mt-2 pt-2 sm:mt-4 sm:pt-3">
			<div class="flex items-center justify-between gap-4">
				<div>
					<p class="text-[16px] text-black/55">Tags</p>
					<div class="mt-1 flex flex-wrap gap-1.5">
						{
							tags.map((tag) => (
								<span class="rounded-full mt-3 bg-[#f2f2f2] px-2 py-1 text-[15px] font-medium text-black/65">
									{tag}
								</span>
							))
						}
					</div>
				</div>

				<div class="shrink-0 text-right">
					<p class="text-[10px] text-black/55">Share</p>
					<div class="mt-1 flex justify-end gap-2">
						<a
							href="https://x.com/intent/post"
							target="_blank"
							rel="noreferrer"
							aria-label="Share on X"
							class="flex h-6 w-6 items-center justify-center rounded-full bg-black text-[11px] font-medium text-white"
						>
							X
						</a>
						<a
							href="https://www.linkedin.com/sharing/share-offsite/"
							target="_blank"
							rel="noreferrer"
							aria-label="Share on LinkedIn"
							class="flex h-6 w-6 items-center justify-center rounded-full bg-black text-[10px] font-semibold text-white"
						>
							in
						</a>
					</div>
				</div>
			</div>

			<a
				href="/blog"
				class="mt-4 inline-flex items-center gap-2 rounded-full bg-black px-4 py-2 text-[15px] font-medium text-white transition-opacity hover:opacity-75"
			>
				<span
					class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-[#ff2d55] to-[#7c3aed]"
				></span>
				More Insights
			</a>
		</footer>
	</div>
</article>
