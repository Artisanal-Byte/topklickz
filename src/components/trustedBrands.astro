---
import { Image } from "astro:assets";

const { trustedBrands } = Astro.props;
---

<section class="relative bg-white py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1
    gap-12
    lg:grid-cols-[1.7fr_1fr]
    lg:items-center
    lg:gap-16"
    >
      <!-- Left Content -->
      <div class="w-full">
        <h2
          class="font-clash text-4xl font-semibold leading-[93%] tracking-[0] uppercase md:text-[48px] lg:text-[50px]"
        >
          {trustedBrands.title}

          <span
            class="gradient-text"
          >
            {" "}
            {trustedBrands.highlight}
          </span>
        </h2>

        <p
          class="mt-3 max-w-xl font-geist text-lg leading-[114%] tracking-[0] text-black sm:text-[22px] lg:text-[25px]"
        >
          {trustedBrands.description}
        </p>
      </div>

      <!-- Animated Brand Orbit -->
      <div class="trusted-orbit" aria-label="Brands trusted by Topklickz">
        {
          [
            { name: "inner", radius: "clamp(88px, 11vw, 124px)", offset: 0 },
            { name: "middle", radius: "clamp(122px, 15vw, 166px)", offset: 45 },
            { name: "outer", radius: "clamp(158px, 19vw, 208px)", offset: 90 },
          ].map((orbit) => (
            <div
              class={`trusted-orbit__ring trusted-orbit__ring--${orbit.name}`}
              style={`--orbit-radius: ${orbit.radius}`}
            >
              <span class="trusted-orbit__track" aria-hidden="true"></span>
              {
                trustedBrands.logos
                  .filter((_, index) => index % 3 === ["inner", "middle", "outer"].indexOf(orbit.name))
                  .map((logo, index) => (
                    <a
                      href={logo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="trusted-orbit__item"
                      style={`--orbit-angle: ${orbit.offset + index * 180}deg`}
                      aria-label={logo.alt}
                    >
                      <span class="trusted-orbit__item-inner">
                        <Image
                          src={logo.image}
                          alt={logo.alt}
                          width={180}
                          height={90}
                          loading="eager"
                          class="trusted-orbit__logo"
                        />
                      </span>
                    </a>
                  ))
              }
            </div>
          ))
        }

        <div class="trusted-orbit__center">
          <Image
            src="/uploads/logo/navbar/logo.png"
            alt="Topklickz"
            width={30}
            height={30}
            loading="eager"
            class="trusted-orbit__center-logo"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Full-width Bottom Gradient Border -->
  <div
    class="pointer-events-none
      absolute inset-x-0 bottom-0
      h-[3px]
      bg-gradient-to-r
      from-orange-500
      via-pink-500
      to-violet-600"
    aria-hidden="true"
  >
  </div>
</section>

<style>
  .trusted-orbit {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1;
    margin-inline: auto;
    isolation: isolate;
  }

  .trusted-orbit__ring {
    position: absolute;
    inset: 0;
    animation: trusted-brands-spin 28s linear infinite;
  }

  .trusted-orbit__ring--inner {
    animation-duration: 19s;
  }

  .trusted-orbit__ring--middle {
    animation-duration: 27s;
    animation-direction: reverse;
  }

  .trusted-orbit__ring--outer {
    animation-duration: 35s;
  }

  .trusted-orbit__track {
    position: absolute;
    inset: calc(50% - var(--orbit-radius));
    border: 1px solid rgba(83, 66, 214, 0.2);
    border-radius: 9999px;
  }

  .trusted-orbit__ring--middle .trusted-orbit__track {
    border-style: dashed;
    border-color: rgba(83, 66, 214, 0.24);
  }

  .trusted-orbit__ring--outer .trusted-orbit__track {
    border-color: rgba(242, 32, 62, 0.2);
  }

  .trusted-orbit__item {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(48px, 5.8vw, 54px);
    height: clamp(48px, 5.8vw, 54px);
    place-items: center;
    transform: translate(-50%, -50%) rotate(var(--orbit-angle)) translateY(calc(var(--orbit-radius) * -1));
    transition: filter 240ms ease, scale 240ms ease;
  }

  .trusted-orbit__item:hover {
    z-index: 2;
    filter: drop-shadow(0 8px 12px rgba(83, 66, 214, 0.2));
    scale: 1.08;
  }

  .trusted-orbit__item:focus-visible {
    outline: 2px solid #5342d6;
    outline-offset: 6px;
  }

  .trusted-orbit__item-inner {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 3px;
  }

  .trusted-orbit__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 7px rgba(27, 21, 58, 0.12));
  }

  .trusted-orbit__center {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(52px, 10vw, 98px);
    height: clamp(52px, 10vw, 98px);
    place-items: center;
    border: 1px solid rgba(83, 66, 214, 0.16);
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 12px 34px rgba(27, 21, 58, 0.12);
    transform: translate(-50%, -50%);
    z-index: 1;
    animation: trusted-brands-center-pulse 4s ease-in-out infinite;
  }

  .trusted-orbit__center-logo {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .trusted-orbit:hover .trusted-orbit__ring {
    animation-play-state: paused;
  }

  @keyframes trusted-brands-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes trusted-brands-center-pulse {
    0%,
    100% {
      box-shadow: 0 12px 34px rgba(27, 21, 58, 0.12);
    }

    50% {
      box-shadow: 0 18px 44px rgba(83, 66, 214, 0.2);
    }
  }

  @media (max-width: 639px) {
    .trusted-orbit {
      width: min(100%, 350px);
    }

    .trusted-orbit__ring--inner {
      --orbit-radius: 76px !important;
    }

    .trusted-orbit__ring--middle {
      --orbit-radius: 104px !important;
    }

    .trusted-orbit__ring--outer {
      --orbit-radius: 132px !important;
    }

    .trusted-orbit__center {
      width: 154px;
      height: 154px;
    }

    .trusted-orbit__item {
      width: 64px;
      height: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trusted-orbit__ring {
      animation: none;
    }

    .trusted-orbit__center {
      animation: none;
    }
  }
</style>
