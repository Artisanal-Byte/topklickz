---
const { faq } = Astro.props;
const items = faq.items.map((item, index) => ({
  ...item,
  isDefaultOpen: item.defaultOpen || index === 0,
}));
---

<section class="py-10 sm:py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2
      class="font-clash text-4xl font-semibold leading-[93%] tracking-[0] uppercase md:text-[48px] lg:text-[50px]"
    >
      {faq.title}
      <span class="gradient-text">
        {" "}
        {faq.highlight}
      </span>
    </h2>

    <div class="mt-8">
      <div
        class="h-px w-full bg-gradient-to-r from-[#FEC053] via-[#F2203E] via-50% to-[#5342D6] opacity-90"
      >
      </div>

      {
        items.map((faq, index) => (
          <>
            <div
              class="py-6"
              data-faq-item
              data-open={faq.isDefaultOpen ? "true" : "false"}
            >
              <button
                type="button"
                class="
                    flex w-full flex-wrap
                    cursor-pointer
                    items-center
                    justify-between
                    gap-4
                    text-left
                    font-clash
                    text-[25px]
                    font-medium
                    leading-[28.8px]
                    tracking-normal
                  "
                aria-expanded={faq.isDefaultOpen ? "true" : "false"}
                data-faq-trigger
              >
                <span
                  class="
		font-medium
		text-[20px]
	"
                >
                  {faq.question}
                </span>

                <span
                  class="text-[24px] transition-transform duration-300"
                  data-faq-icon
                >
                  +
                </span>
              </button>

              <div
                class="faq-panel"
                aria-hidden={faq.isDefaultOpen ? "false" : "true"}
                data-faq-panel
              >
                <div class="overflow-hidden">
                  <p
                    class="
                        pt-5
                        max-w-3xl
                        font-geist
                        text-base
                        leading-[28.8px]
                        tracking-normal
                        text-[#010101]
                        sm:text-[18px]
                      "
                  >
                    {faq.answer}
                  </p>
                </div>
              </div>
            </div>

            {index < items.length - 1 && (
              <div class="h-px w-full bg-gradient-to-r from-[#FEC053] via-[#F2203E] via-50% to-[#5342D6] opacity-90" />
            )}
          </>
        ))
      }

      <div
        class="h-px w-full bg-gradient-to-r from-[#FEC053] via-[#F2203E] via-50% to-[#5342D6] opacity-90"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 420ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease;
  }

  [data-faq-item][data-open="true"] .faq-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  [data-faq-item][data-open="true"] [data-faq-trigger] span:first-child {
    font-weight: 700;
  }

  [data-faq-item][data-open="true"] [data-faq-icon] {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel {
      transition: none;
    }
  }
</style>

<script>
  const initFaqAccordion = () => {
    const accordionItems = Array.from(
      document.querySelectorAll<HTMLElement>("[data-faq-item]")
    );

    accordionItems.forEach((item) => {
      if (item.dataset.faqReady === "true") return;
      item.dataset.faqReady = "true";

      const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-faq-panel]");
      const icon = item.querySelector<HTMLElement>("[data-faq-icon]");

      trigger?.addEventListener("click", () => {
        const shouldOpen = item.dataset.open !== "true";

        accordionItems.forEach((otherItem) => {
          const isOpen = otherItem === item && shouldOpen;
          otherItem.dataset.open = String(isOpen);
          otherItem
            .querySelector<HTMLButtonElement>("[data-faq-trigger]")
            ?.setAttribute("aria-expanded", String(isOpen));
          otherItem
            .querySelector<HTMLElement>("[data-faq-panel]")
            ?.setAttribute("aria-hidden", String(!isOpen));
        });
      });
    });
  };

  initFaqAccordion();
  document.addEventListener("astro:page-load", initFaqAccordion);
</script>
