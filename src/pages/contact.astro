---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { createReader } from "@keystatic/core/reader";
import config from "../../keystatic.config";
const reader = createReader(process.cwd(), config);
const site = await reader.singletons.site.read();
import Hero from "../components/contact/hero.astro";
import ContactItems from "../components/contact/contactItems.astro";
import Faq from "../components/contact/faqs.astro";
import Cta from "../components/contact/cta.astro";
import AboutCtc from "../components/AboutCtc.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
    <Header navbar={site?.navbar} />
    <Hero />
    <ContactItems />
    <Faq />
    <Cta />
    <AboutCtc />
    <Footer footer={site?.footer} />
</Layout>    