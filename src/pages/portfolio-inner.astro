---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import config from "../../keystatic.config";
import PortfolioInnerHero from "../components/portfolio/PortfolioInnerHero.astro";
import { createReader } from "@keystatic/core/reader";
import PortfolioInnerImage from "../components/portfolio/PortfolioInnerImage.astro";
import PortfolioInnerOverview from "../components/portfolio/PortfolioInnerOverview.astro";
import PortfolioInnerImageSection from "../components/portfolio/PortfolioInnerImagsSection.astro";
import PortfolioInnerProcess from "../components/portfolio/PortfolioInnerProcess.astro";
import PortfolioInnerThinking from "../components/portfolio/PortfolioInnerThinking.astro";
import PortfolioInnerWrok from "../components/portfolio/PortfolioInnerWork.astro";
import PortfolioInnerContext from "../components/portfolio/PortfolioInnerContext.astro";
import PortfolioInnerKeyResults from "../components/portfolio/PortfolioInnerKeyResults.astro";
import PortfolioInnerTestimonial from "../components/portfolio/PortfolioInnerTestimonial.astro";
import NextProject from "../components/portfolio/NextProject.astro";
import Cta from "../components/Cta.astro";
const reader = createReader(process.cwd(), config);
const site = await reader.singletons.site.read();
---

<Layout>
    <Header navbar={site?.navbar} />
    <PortfolioInnerHero />
    <PortfolioInnerImage />
    <PortfolioInnerOverview />
    <PortfolioInnerImageSection />
    <PortfolioInnerProcess />
    <PortfolioInnerThinking />
    <PortfolioInnerWrok />
    <PortfolioInnerContext />
    <PortfolioInnerKeyResults />
    <PortfolioInnerTestimonial />
    <NextProject />
    <Cta cta={site?.cta} />
    <Footer footer={site?.footer} />
</Layout>
