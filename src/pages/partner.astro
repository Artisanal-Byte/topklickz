---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../partner/hero.astro";
import Stats from "../partner/stats.astro";
import CoreExpertise from "../partner/coreexpertise.astro";
import OperationalExcellence from "../partner/operationalexcellence.astro";
import CertificationsCredentials from "../partner/certificationscredentials.astro";
import EngagementProcess from "../partner/engagementprocess.astro";
import { createReader } from "@keystatic/core/reader";
import config from "../../keystatic.config";
import AboutCtc from "../components/AboutCtc.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
const reader = createReader(process.cwd(), config);
const site = await reader.singletons.site.read();
---

<Layout>
    <Header navbar={site?.navbar} />
    <Hero />
    <Stats />
    <CoreExpertise />
    <EngagementProcess />
    <OperationalExcellence />
    <CertificationsCredentials />
       <Cta />
     <AboutCtc />
       <Footer footer={site?.footer} />
</Layout>
